# Copy this file to .env.local and fill it in. Never commit .env.local.

# While the database is still being built, this is all you need:
NEXT_PUBLIC_USE_MOCKS=true

# Bilal fills these in once the Supabase project exists.
# The anon key is safe in the browser: RLS denies every client write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
